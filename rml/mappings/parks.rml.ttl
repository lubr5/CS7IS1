@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dlr:  <http://example.org/dlr/ontology#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@base <http://example.org/dlr/mapping/> .

<ParkTriplesMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "sources/dlr_mainparks.csv" ;
        rml:referenceFormulation ql:CSV 
    ] ; 
    rr:subjectMap [
        rr:template "http://example.org/dlr/id/park/{OBJECTID}" ;
        rr:class dlr:Park
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "park_name"]
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "irish_name" ; rr:language "ga" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:altLabel ;
        rr:objectMap [ rml:reference "previous_name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:address ;
        rr:objectMap [ rml:reference "address" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:parkType ;
        rr:objectMap [ rml:reference "type" ]
    ] .
