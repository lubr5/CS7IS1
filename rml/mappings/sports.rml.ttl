@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dlr:    <http://example.org/dlr/ontology#> .
@base <http://example.org/dlr/mapping/> .

<TennisClubTriplesMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "sources/dlr_tennisclubs.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/dlr/id/tennis/{OBJECTID}" ;
        rr:class dlr:SportsFacility
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "Name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:address ;
        rr:objectMap [ rml:reference "Address" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:telephone ;
        rr:objectMap [ rml:reference "Phone" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:email ;
        rr:objectMap [ rml:reference "Email" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:facilityType ;
        rr:objectMap [ rr:constant "Tennis Club" ]
    ] .

<SkateParkTriplesMap> 
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "sources/dlr_skateparks.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/dlr/id/skatepark/{OBJECTID}" ;
        rr:class dlr:SportsFacility
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "Name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:address ;
        rr:objectMap [ rml:reference "Address" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:telephone ;
        rr:objectMap [ rml:reference "Phone" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:facilityType ;
        rr:objectMap [ rr:constant "Skate Park" ]
    ] .

<LeisureCentreTriplesMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "sources/dlr_leisurecentres.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/dlr/id/leisurecentre/{OBJECTID}" ;
        rr:class dlr:SportsFacility
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "full_name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:altLabel ;
        rr:objectMap [ rml:reference "name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:address ;
        rr:objectMap [ rml:reference "Address" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:telephone ;
        rr:objectMap [ rml:reference "Phone" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:email ;
        rr:objectMap [ rml:reference "Email" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:facilityType ;
        rr:objectMap [ rr:constant "Leisure Centre" ]
    ] .