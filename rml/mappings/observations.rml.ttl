@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dlr:  <http://example.org/dlr/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@base <http://example.org/dlr/mapping/> .

<ObservationsTriplesMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "sources/observations.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/dlr/id/observation/{obs_id}" ;
        rr:class dlr:FootfallObservation
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:observedAt ;
        rr:objectMap [ rml:reference "timestamp"; rr:datatype xsd:dateTime ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:totalCount ;
        rr:objectMap [ rml:reference "total"; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:inCount ;
        rr:objectMap [ rml:reference "in_count"; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:outCount ;
        rr:objectMap [ rml:reference "out_count"; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:recordedBy ;
        rr:objectMap [
            rr:template "http://example.org/dlr/id/counter/{counter_id}" ;
            rr:termType rr:IRI
        ]
    ] .