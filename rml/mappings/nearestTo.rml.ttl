@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix dlr:  <http://example.org/dlr/ontology#> .
@base <http://example.org/dlr/mapping/> .

<NearestCounterTriplesMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "sources/nearestTo.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/dlr/id/{amenity_type}/{amenity_id}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:nearestCounter ;
        rr:objectMap [
            rr:template "http://example.org/dlr/id/counter/{counter_id}" ;
            rr:termType rr:IRI
        ]
    ] .

<IsNearestCounterForTriplesMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "sources/invertedNearestTo.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/dlr/id/counter/{counter_id}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:isNearestCounterFor ;
        rr:objectMap [
            rr:template "http://example.org/dlr/id/{amenity_type}/{amenity_id}" ;
            rr:termType rr:IRI
        ]
    ] .
