@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix dlr:  <http://example.org/dlr/ontology#> .
@base <http://example.org/dlr/mapping/> .


<AmenityAreaTriplesMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "sources/invented_amenity_areas.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/dlr/id/{amenity_type}/{amenity_id}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate dlr:locatedIn ;
        rr:objectMap [
            rr:template "http://example.org/dlr/id/area/{area_id}" ;
            rr:termType rr:IRI
        ]
    ] .
