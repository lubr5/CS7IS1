PREFIX dlr:  <http://example.org/dlr/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

# src: C.2.2.1. https://docs.ogc.org/is/22-047r1/22-047r1.html
SELECT ?parkLabel ?infrastructureLabel ?parkShape ?infrastructureShape #optional shape values returned so park renders
WHERE {
  ?park a dlr:Park ;
        rdfs:label ?parkLabel ;
        geo:hasGeometry ?parkGeom .
  ?parkGeom geo:asWKT ?parkShape .

  ?infrastructure a dlr:Infrastructure ;
                  rdfs:label ?infrastructureLabel ;
                  geo:hasGeometry ?infrastructureGeom .
  ?infrastructureGeom geo:asWKT ?infrastructureShape .

  FILTER (
    geof:sfContains(?parkShape, ?infrastructureShape) &&
    !sameTerm(?parkGeom, ?infrastructureGeom)
  )
  FILTER(LANG(?parkLabel) != "ga")
}
ORDER BY ?parkLabel ?infrastructureLabel
